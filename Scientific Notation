
# ✅ Scientific Notation — Easiest Examples

# Format: number_e_power → means: number × 10^power

a = 1e2   # 1 × 10^2 = 1 × 100 = 100.0
b = 2e3   # 2 × 10^3 = 2 × 1000 = 2000.0
c = 3e0   # 3 × 10^0 = 3 × 1 = 3.0
d = 4e-1  # 4 × 10^-1 = 4 × 0.1 = 0.4
e = 5e-3  # 5 × 10^-3 = 5 × 0.001 = 0.005

# All are floats
print(a, b, c, d, e)
# Output: 100.0 2000.0 3.0 0.4 0.005


